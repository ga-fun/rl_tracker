$ErrorActionPreference = "Stop"

Add-Type -AssemblyName System.Windows.Forms
Add-Type -AssemblyName System.Drawing

$script:Port = 49123
$script:ShouldRun = $false
$script:TcpClient = $null
$script:Stream = $null
$script:ReceiveBuffer = ""
$script:LastConnectAttempt = Get-Date "2000-01-01"
$script:MatchGuid = ""
$script:PlayerTeam = $null
$script:CountedMatches = @{}
$script:History = New-Object System.Collections.ArrayList
$script:Stats = [ordered]@{
	Wins = 0
	Losses = 0
	Streak = 0
	Last = "-"
}
$script:LastPlayersSignature = ""
$script:SettingsPath = Join-Path $PSScriptRoot "settings.json"
$script:TrackedPrimaryId = ""
$script:SavedPlayers = @{}
$script:ManualSelectionOrder = 0
$script:CurrentPlayers = @()
$script:IsAutoSelecting = $false
$script:LastFinishedMatchGuid = ""
$script:CurrentHasWinner = $false
$script:CurrentGameStatus = ""
$script:CurrentScoreKnown = $false
$script:LastScoreTotal = -1
$script:LastScoreMatchGuid = ""
$script:ModeOrder = @("1v1", "2v2", "3v3", "other")
$script:StatsByMode = @{}
$script:CurrentMode = "unknown"
$script:MaxPlayersInMatch = 0
$script:PlayersDetectedLogged = $false
$script:PlayersDetectedDue = $null
$script:LastSelectionLogKey = ""

function New-Label($text, $x, $y, $width, $height) {
	$label = New-Object System.Windows.Forms.Label
	$label.Text = $text
	$label.Location = New-Object System.Drawing.Point($x, $y)
	$label.Size = New-Object System.Drawing.Size($width, $height)
	$label.ForeColor = [System.Drawing.Color]::White
	return $label
}

function New-Button($text, $x, $y, $width, $height) {
	$button = New-Object System.Windows.Forms.Button
	$button.Text = $text
	$button.Location = New-Object System.Drawing.Point($x, $y)
	$button.Size = New-Object System.Drawing.Size($width, $height)
	return $button
}

function Write-AppLog($text) {
	$line = "[{0}] {1}" -f (Get-Date -Format "HH:mm:ss"), $text
	$logBox.AppendText($line + [Environment]::NewLine)
}

function Set-Status($text, $ok) {
	$statusLabel.Text = $text
	if ($ok) {
		$statusLabel.ForeColor = [System.Drawing.Color]::LightGreen
	} else {
		$statusLabel.ForeColor = [System.Drawing.Color]::Tomato
	}
}

function Get-PrimaryIdParts($primaryId) {
	$parts = ([string]$primaryId).Split("|")
	$platform = "Unknown"
	$platformId = [string]$primaryId
	if ($parts.Count -ge 1 -and $parts[0]) {
		$platform = [string]$parts[0]
	}
	if ($parts.Count -ge 2 -and $parts[1]) {
		$platformId = [string]$parts[1]
	}
	return [PSCustomObject]@{
		Platform = $platform
		PlatformId = $platformId
	}
}

function Get-TrackerUrl($playerInfo) {
	if (-not $playerInfo) {
		return ""
	}
	$platform = ([string]$playerInfo.Platform).ToLowerInvariant()
	if ($platform -eq "epic") {
		$name = [uri]::EscapeDataString([string]$playerInfo.Name)
		return "https://rocketleague.tracker.network/rocket-league/profile/epic/$name/mmr?playlist=11"
	}
	if ($platform -eq "steam") {
		$id = [uri]::EscapeDataString([string]$playerInfo.PlatformId)
		return "https://rocketleague.tracker.network/rocket-league/profile/steam/$id/mmr?playlist=11"
	}
	if ($platform -eq "psn" -or $platform -eq "playstation") {
		$id = [uri]::EscapeDataString([string]$playerInfo.PlatformId)
		return "https://rocketleague.tracker.network/rocket-league/profile/psn/$id/mmr?playlist=11"
	}
	if ($platform -eq "xbox" -or $platform -eq "xbl") {
		$id = [uri]::EscapeDataString([string]$playerInfo.PlatformId)
		return "https://rocketleague.tracker.network/rocket-league/profile/xbl/$id/mmr?playlist=11"
	}
	return ""
}

function New-PlayerInfo($player) {
	$parts = Get-PrimaryIdParts $player.PrimaryId
	$name = [string]$player.Name
	$primaryId = [string]$player.PrimaryId
	$display = "{0} [{1}:{2}]" -f $name, $parts.Platform, $parts.PlatformId
	$info = [PSCustomObject]@{
		Name = $name
		PrimaryId = $primaryId
		Platform = [string]$parts.Platform
		PlatformId = [string]$parts.PlatformId
		TeamNum = [int]$player.TeamNum
		Display = $display
		TrackerUrl = ""
	}
	$info.TrackerUrl = Get-TrackerUrl $info
	return $info
}

function Get-PlayerLogDisplay($playerInfo) {
	if (-not $playerInfo) {
		return "unknown player"
	}
	return "{0} [{1}:{2}]" -f `
		$playerInfo.Name, $playerInfo.Platform, $playerInfo.PlatformId
}

function Load-Settings {
	if (-not (Test-Path $script:SettingsPath)) {
		return
	}
	try {
		$settings = Get-Content $script:SettingsPath -Raw | ConvertFrom-Json
		if ($settings.Port) {
			$portBox.Text = [string]$settings.Port
			$script:Port = [int]$settings.Port
		}
		if ($settings.ManualSelectionOrder) {
			$script:ManualSelectionOrder = [int]$settings.ManualSelectionOrder
		}
		Import-SavedPlayers $settings
		if ($settings.PlayerPrimaryId) {
			$script:TrackedPrimaryId = [string]$settings.PlayerPrimaryId
		}
		elseif ($settings.TrackedPrimaryId) {
			$script:TrackedPrimaryId = [string]$settings.TrackedPrimaryId
		}
	} catch {
	}
}

function Import-SavedPlayers($settings) {
	if ($settings.SavedPlayers) {
		foreach ($saved in @($settings.SavedPlayers)) {
			Import-SavedPlayer $saved
		}
	}
	elseif ($settings.PlayerPrimaryId) {
		$legacy = [PSCustomObject]@{
			Name = [string]$settings.PlayerName
			PrimaryId = [string]$settings.PlayerPrimaryId
			LastManualOrder = 1
		}
		Import-SavedPlayer $legacy
	}
}

function Import-SavedPlayer($saved) {
	if (-not $saved.PrimaryId) {
		return
	}
	$parts = Get-PrimaryIdParts $saved.PrimaryId
	$order = if ($saved.LastManualOrder) { [int]$saved.LastManualOrder } else { 0 }
	$entry = [PSCustomObject]@{
		Name = [string]$saved.Name
		PrimaryId = [string]$saved.PrimaryId
		Platform = if ($saved.Platform) { [string]$saved.Platform } else { [string]$parts.Platform }
		PlatformId = if ($saved.PlatformId) { [string]$saved.PlatformId } else { [string]$parts.PlatformId }
		LastManualOrder = $order
	}
	$script:SavedPlayers[$entry.PrimaryId] = $entry
	if ($order -gt $script:ManualSelectionOrder) {
		$script:ManualSelectionOrder = $order
	}
}

function Save-Settings {
	$script:Port = [int]$portBox.Text
	$settings = [ordered]@{
		TrackedPrimaryId = $script:TrackedPrimaryId
		PlayerPrimaryId = $script:TrackedPrimaryId
		Port = $script:Port
		ManualSelectionOrder = $script:ManualSelectionOrder
		SavedPlayers = Get-SavedPlayersForSettings
	}
	$settings | ConvertTo-Json -Depth 6 | Set-Content $script:SettingsPath -Encoding UTF8
}

function Get-SavedPlayersForSettings {
	$players = @()
	foreach ($entry in $script:SavedPlayers.Values) {
		$players += [ordered]@{
			Name = [string]$entry.Name
			PrimaryId = [string]$entry.PrimaryId
			Platform = [string]$entry.Platform
			PlatformId = [string]$entry.PlatformId
			LastManualOrder = [int]$entry.LastManualOrder
		}
	}
	return @($players | Sort-Object LastManualOrder -Descending)
}

function Update-StatsView {
	$stats = Get-ActiveStats
	$winsValue.Text = [string]$stats.Wins
	$lossesValue.Text = [string]$stats.Losses
	$streakValue.Text = [string]$stats.Streak
	$lastValue.Text = [string]$stats.Last
	$teamValue.Text = Get-TeamName $script:PlayerTeam
	$matchValue.Text = if ($script:MatchGuid) { $script:MatchGuid } else { "-" }
	$eventValue.Text = Get-ModeLabel
}

function Get-TeamName($teamNum) {
	if ($teamNum -eq 0) {
		return "Blue"
	}
	if ($teamNum -eq 1) {
		return "Orange"
	}
	return "-"
}

function Get-ResultWord($result) {
	if ($result -eq "W") {
		return "win"
	}
	if ($result -eq "L") {
		return "loss"
	}
	if ($result -eq "T") {
		return "tie"
	}
	return "unknown"
}

function New-StatsObject {
	return [PSCustomObject]@{
		Wins = 0
		Losses = 0
		Streak = 0
		Last = "-"
	}
}

function Initialize-StatsByMode {
	foreach ($mode in $script:ModeOrder) {
		if (-not $script:StatsByMode.ContainsKey($mode)) {
			$script:StatsByMode[$mode] = New-StatsObject
		}
	}
}

function Get-ModeFromPlayerCount($count) {
	if ($count -eq 2) {
		return "1v1"
	}
	if ($count -eq 4) {
		return "2v2"
	}
	if ($count -eq 6) {
		return "3v3"
	}
	if ($count -gt 0) {
		return "other"
	}
	return "unknown"
}

function Get-ActiveMode {
	if ($script:CurrentMode -and $script:CurrentMode -ne "unknown") {
		return $script:CurrentMode
	}
	$mode = Get-ModeFromPlayerCount $script:MaxPlayersInMatch
	if ($mode -ne "unknown") {
		return $mode
	}
	return "other"
}

function Get-ActiveStats {
	$mode = Get-ActiveMode
	if (-not $script:StatsByMode.ContainsKey($mode)) {
		$script:StatsByMode[$mode] = New-StatsObject
	}
	return $script:StatsByMode[$mode]
}

function Reset-AllModeStats {
	foreach ($mode in $script:ModeOrder) {
		$script:StatsByMode[$mode] = New-StatsObject
	}
}

function Get-ModeLabel {
	$mode = Get-ActiveMode
	return $mode
}

function Reset-CurrentMatchState($guid) {
	$script:CurrentHasWinner = $false
	$script:CurrentGameStatus = ""
	$script:CurrentScoreKnown = $false
	$script:LastScoreTotal = -1
	$script:LastScoreMatchGuid = [string]$guid
	$script:CurrentMode = "unknown"
	$script:MaxPlayersInMatch = 0
	$script:PlayersDetectedLogged = $false
	$script:PlayersDetectedDue = $null
	$script:LastSelectionLogKey = ""
}

function Reset-Session {
	Reset-AllModeStats
	$script:CountedMatches = @{}
	if ($script:LastFinishedMatchGuid) {
		$script:CountedMatches[$script:LastFinishedMatchGuid] = $true
	}
	if ($script:CurrentHasWinner -and $script:MatchGuid) {
		$script:CountedMatches[$script:MatchGuid] = $true
	}
	$script:History.Clear()
	Update-StatsView
}

function Apply-Result($mode, $result) {
	if (-not $script:StatsByMode.ContainsKey($mode)) {
		$script:StatsByMode[$mode] = New-StatsObject
	}
	$stats = $script:StatsByMode[$mode]
	if ($result -eq "W") {
		$stats.Wins++
		if ($stats.Streak -gt 0) {
			$stats.Streak++
		} else {
			$stats.Streak = 1
		}
	} else {
		$stats.Losses++
		if ($stats.Streak -lt 0) {
			$stats.Streak--
		} else {
			$stats.Streak = -1
		}
	}
	$stats.Last = $result
}

function Add-HistoryEntry($mode, $result) {
	$entry = [PSCustomObject]@{
		Mode = [string]$mode
		Result = [string]$result
	}
	[void]$script:History.Add($entry)
}

function Add-ManualResult($result) {
	$mode = Get-ActiveMode
	Apply-Result $mode $result
	Add-HistoryEntry $mode $result
	Update-StatsView
	Write-AppLog ("Tracker updated: manual, {0}" -f (Get-ResultWord $result))
}

function Undo-LastResult {
	if ($script:History.Count -eq 0) {
		return
	}
	$script:History.RemoveAt($script:History.Count - 1)
	$oldHistory = @($script:History)
	Reset-AllModeStats
	$script:History.Clear()
	foreach ($entry in $oldHistory) {
		Apply-Result $entry.Mode $entry.Result
		Add-HistoryEntry $entry.Mode $entry.Result
	}
	Update-StatsView
}

function Commit-Result($guid, $result, $source, $mode) {
	if (-not $source) {
		$source = "auto"
	}
	if (-not $mode -or $mode -eq "unknown") {
		$mode = Get-ActiveMode
	}
	if (-not $guid) {
		$guid = "unknown-" + [Guid]::NewGuid().ToString()
	}
	if ($script:CountedMatches.ContainsKey($guid)) {
		return
	}
	$script:CountedMatches[$guid] = $true
	$script:LastFinishedMatchGuid = $guid
	Apply-Result $mode $result
	Add-HistoryEntry $mode $result
	Update-StatsView
	Write-AppLog ("Tracker updated: {0}, {1}" -f $source, (Get-ResultWord $result))
}

function Close-Connection {
	try {
		if ($script:Stream) {
			$script:Stream.Close()
		}
		if ($script:TcpClient) {
			$script:TcpClient.Close()
		}
	} catch {
	}
	$script:Stream = $null
	$script:TcpClient = $null
	$script:ReceiveBuffer = ""
}

function Test-ConnectionOpen {
	return ($script:TcpClient -ne $null -and $script:TcpClient.Connected)
}

function Try-Connect {
	if (-not $script:ShouldRun) {
		return
	}
	if (Test-ConnectionOpen) {
		return
	}
	if (((Get-Date) - $script:LastConnectAttempt).TotalMilliseconds -lt 1000) {
		return
	}
	$script:LastConnectAttempt = Get-Date
	try {
		Close-Connection
		$script:TcpClient = New-Object System.Net.Sockets.TcpClient
		$script:TcpClient.Connect("127.0.0.1", $script:Port)
		$script:Stream = $script:TcpClient.GetStream()
		Set-Status "Connected to RL Stats API" $true
	} catch {
		Close-Connection
		Set-Status "Waiting for Rocket League match..." $false
	}
}

function Read-AvailableData {
	if (-not (Test-ConnectionOpen)) {
		return
	}
	try {
		$bytes = New-Object byte[] 65536
		while ($script:Stream.DataAvailable) {
			$count = $script:Stream.Read($bytes, 0, $bytes.Length)
			if ($count -le 0) {
				throw "Socket closed"
			}
			$script:ReceiveBuffer += [System.Text.Encoding]::UTF8.GetString($bytes, 0, $count)
		}
		Process-BufferedMessages
	} catch {
		Close-Connection
	}
}

function Get-NextJsonMessage {
	$buffer = $script:ReceiveBuffer
	$start = $buffer.IndexOf("{")
	if ($start -lt 0) {
		$script:ReceiveBuffer = ""
		return $null
	}
	if ($start -gt 0) {
		$buffer = $buffer.Substring($start)
	}
	$depth = 0
	$inString = $false
	$escaped = $false
	for ($index = 0; $index -lt $buffer.Length; $index++) {
		$char = $buffer[$index]
		if ($inString) {
			if ($escaped) {
				$escaped = $false
			} elseif ($char -eq '\') {
				$escaped = $true
			} elseif ($char -eq '"') {
				$inString = $false
			}
			continue
		}
		if ($char -eq '"') {
			$inString = $true
		} elseif ($char -eq '{') {
			$depth++
		} elseif ($char -eq '}') {
			$depth--
			if ($depth -eq 0) {
				$json = $buffer.Substring(0, $index + 1)
				$script:ReceiveBuffer = $buffer.Substring($index + 1)
				return $json
			}
		}
	}
	$script:ReceiveBuffer = $buffer
	return $null
}

function Convert-EventData($data) {
	if ($null -eq $data) {
		return $null
	}
	if ($data -is [string]) {
		$trimmed = $data.Trim()
		if (-not $trimmed) {
			return $data
		}
		try {
			return ($trimmed | ConvertFrom-Json)
		} catch {
			return $data
		}
	}
	return $data
}

function Process-BufferedMessages {
	while ($true) {
		$json = Get-NextJsonMessage
		if (-not $json) {
			return
		}
		try {
			$message = $json | ConvertFrom-Json
			$data = Convert-EventData $message.Data
			Process-StatsEvent ([string]$message.Event) $data
		} catch {
		}
	}
}

function Process-StatsEvent($eventName, $data) {
	if ($eventName -eq "UpdateState") {
		Process-UpdateState $data
	} elseif ($eventName -eq "MatchEnded") {
		Process-MatchEnded $data
	} elseif ($eventName -eq "MatchDestroyed") {
		Process-MatchDestroyed
	}
}

function Process-UpdateState($data) {
	if ($data.MatchGuid) {
		$newGuid = [string]$data.MatchGuid
		if ($newGuid -ne $script:MatchGuid) {
			Reset-CurrentMatchState $newGuid
		}
		$script:MatchGuid = $newGuid
	}
	Update-PlayerList @($data.Players)
	Update-TrackedTeam @($data.Players)
	Update-CurrentScoreState $data.Game
	if ($data.Game -and $data.Game.bHasWinner -and $data.Game.Winner) {
		$script:CurrentHasWinner = $true
		$winnerTeam = Get-TeamNumFromName $data.Game.Winner
		if ($winnerTeam -ne $null -and $script:PlayerTeam -ne $null) {
			$result = if ($winnerTeam -eq $script:PlayerTeam) { "W" } else { "L" }
			Commit-Result $script:MatchGuid $result "auto" (Get-ActiveMode)
		}
	}
	Update-StatsView
}

function Update-CurrentScoreState($game) {
	$score = Get-TrackedScoreState $game
	if (-not $score) {
		return
	}
	$total = [int]$score.OwnScore + [int]$score.OpponentScore
	if ($script:LastScoreMatchGuid -ne $script:MatchGuid) {
		$script:LastScoreMatchGuid = $script:MatchGuid
		$script:LastScoreTotal = $total
		$script:CurrentScoreKnown = $true
		$script:CurrentGameStatus = [string]$score.Result
		return
	}
	if ($script:CurrentScoreKnown -and $total -gt $script:LastScoreTotal) {
		Flush-PlayersDetectedLog $true
		Write-AppLog ("Goal scored: {0}, score {1}-{2}" -f `
			(Get-ResultWord $score.Result), $score.OwnScore, $score.OpponentScore)
	}
	$script:LastScoreTotal = $total
	$script:CurrentScoreKnown = $true
	$script:CurrentGameStatus = [string]$score.Result
}

function Get-TrackedScoreState($game) {
	if (-not $game -or -not $game.Teams -or $script:PlayerTeam -eq $null) {
		return $null
	}
	$ownScore = $null
	$opponentScore = $null
	foreach ($team in @($game.Teams)) {
		if ([int]$team.TeamNum -eq [int]$script:PlayerTeam) {
			$ownScore = [int]$team.Score
		} else {
			$opponentScore = [int]$team.Score
		}
	}
	if ($ownScore -eq $null -or $opponentScore -eq $null) {
		return $null
	}
	$result = Get-ScoreResult $ownScore $opponentScore
	return [PSCustomObject]@{
		OwnScore = $ownScore
		OpponentScore = $opponentScore
		Result = $result
	}
}

function Get-ScoreResult($ownScore, $opponentScore) {
	if ($ownScore -gt $opponentScore) {
		return "W"
	}
	if ($ownScore -lt $opponentScore) {
		return "L"
	}
	return "T"
}

function Update-PlayerList($players) {
	if (-not $players) {
		return
	}
	$infos = Get-PlayerInfos $players
	Update-MatchModeFromPlayers $infos
	$signature = ($infos | ForEach-Object {
		"{0}:{1}:{2}" -f $_.PrimaryId, $_.Name, $_.TeamNum
	}) -join "|"
	if ($signature -eq $script:LastPlayersSignature) {
		return
	}
	$script:LastPlayersSignature = $signature
	$script:CurrentPlayers = @($infos)
	Refresh-PlayerControls $infos
	Auto-SelectBestSavedPlayer $infos
}

function Update-MatchModeFromPlayers($infos) {
	$count = @($infos).Count
	if ($count -le $script:MaxPlayersInMatch) {
		return
	}
	$script:MaxPlayersInMatch = $count
	$script:CurrentMode = Get-ModeFromPlayerCount $script:MaxPlayersInMatch
	if (-not $script:PlayersDetectedLogged) {
		$script:PlayersDetectedDue = (Get-Date).AddSeconds(8)
	}
	Update-StatsView
}

function Flush-PlayersDetectedLog($force) {
	if ($script:PlayersDetectedLogged) {
		return
	}
	if ($script:MaxPlayersInMatch -le 0) {
		return
	}
	$mode = Get-ModeFromPlayerCount $script:MaxPlayersInMatch
	if (-not $force -and $mode -eq "other") {
		return
	}
	if (-not $force -and $script:PlayersDetectedDue) {
		if ((Get-Date) -lt $script:PlayersDetectedDue) {
			return
		}
	}
	$script:PlayersDetectedLogged = $true
	Write-AppLog ("Players detected: {0}" -f $script:MaxPlayersInMatch)
}

function Get-PlayerInfos($players) {
	$infos = @()
	foreach ($player in $players) {
		if ($player.Name -and $player.PrimaryId) {
			$infos += New-PlayerInfo $player
		}
	}
	return @($infos)
}

function Refresh-PlayerControls($infos) {
	$script:IsAutoSelecting = $true
	try {
		$playerBox.Items.Clear()
		$playersBox.Items.Clear()
		foreach ($info in $infos) {
			[void]$playerBox.Items.Add($info)
			[void]$playersBox.Items.Add($info)
		}
	} finally {
		$script:IsAutoSelecting = $false
	}
}

function Auto-SelectBestSavedPlayer($infos) {
	$best = Get-BestSavedPlayerInGame $infos
	if ($best) {
		Select-Player $best $false
		return
	}
	if ($infos.Count -eq 1) {
		Select-Player $infos[0] $false
		return
	}
	$script:TrackedPrimaryId = ""
	$script:PlayerTeam = $null
}

function Get-BestSavedPlayerInGame($infos) {
	$best = $null
	$bestOrder = -1
	foreach ($info in $infos) {
		$id = [string]$info.PrimaryId
		if (-not $script:SavedPlayers.ContainsKey($id)) {
			continue
		}
		$order = [int]$script:SavedPlayers[$id].LastManualOrder
		if ($order -gt $bestOrder) {
			$best = $info
			$bestOrder = $order
		}
	}
	return $best
}

function Select-Player($playerInfo, $manual) {
	if (-not $playerInfo -or -not $playerInfo.PrimaryId) {
		return
	}
	$script:TrackedPrimaryId = [string]$playerInfo.PrimaryId
	$script:PlayerTeam = [int]$playerInfo.TeamNum
	Set-PlayerBoxSelection $playerInfo.PrimaryId
	if ($manual) {
		Save-ManualPlayerSelection $playerInfo
		Write-PlayerSelectedLog "manual" $playerInfo
	} else {
		Write-PlayerSelectedLog "auto" $playerInfo
	}
}

function Set-PlayerBoxSelection($primaryId) {
	$script:IsAutoSelecting = $true
	try {
		for ($index = 0; $index -lt $playerBox.Items.Count; $index++) {
			$item = $playerBox.Items[$index]
			if ([string]$item.PrimaryId -eq [string]$primaryId) {
				$playerBox.SelectedIndex = $index
				return
			}
		}
	} finally {
		$script:IsAutoSelecting = $false
	}
}

function Save-ManualPlayerSelection($playerInfo) {
	$script:ManualSelectionOrder++
	$entry = [PSCustomObject]@{
		Name = [string]$playerInfo.Name
		PrimaryId = [string]$playerInfo.PrimaryId
		Platform = [string]$playerInfo.Platform
		PlatformId = [string]$playerInfo.PlatformId
		LastManualOrder = [int]$script:ManualSelectionOrder
	}
	$script:SavedPlayers[$entry.PrimaryId] = $entry
	Save-Settings
}

function Write-PlayerSelectedLog($mode, $playerInfo) {
	$key = "{0}|{1}|{2}" -f $script:MatchGuid, $mode, $playerInfo.PrimaryId
	if ($mode -ne "manual" -and $key -eq $script:LastSelectionLogKey) {
		return
	}
	$script:LastSelectionLogKey = $key
	Write-AppLog ("Player selected: {0}, {1}" -f $mode, (Get-PlayerLogDisplay $playerInfo))
}

function Write-PlayersDetectedLog($infos) {
	$count = @($infos).Count
	if ($count -gt 0) {
		Write-AppLog ("Players detected: {0}" -f $count)
	}
}

function Update-TrackedTeam($players) {
	if (-not $script:TrackedPrimaryId) {
		$script:PlayerTeam = $null
		return
	}
	foreach ($player in $players) {
		if ([string]$player.PrimaryId -eq $script:TrackedPrimaryId) {
			$script:PlayerTeam = [int]$player.TeamNum
			return
		}
	}
	$script:PlayerTeam = $null
}

function Get-TeamNumFromName($name) {
	if ($name -eq "Blue" -or $name -eq "Bleu") {
		return 0
	}
	if ($name -eq "Orange") {
		return 1
	}
	return $null
}

function Process-MatchEnded($data) {
	Flush-PlayersDetectedLog $true
	$script:CurrentHasWinner = $true
	if ($script:PlayerTeam -eq $null) {
		return
	}
	$winner = [int]$data.WinnerTeamNum
	$result = if ($winner -eq $script:PlayerTeam) { "W" } else { "L" }
	$guid = if ($data.MatchGuid) { [string]$data.MatchGuid } else { $script:MatchGuid }
	Commit-Result $guid $result "auto" (Get-ActiveMode)
}

function Process-MatchDestroyed {
	Flush-PlayersDetectedLog $true
	Try-CommitFallbackResult
	$script:MatchGuid = ""
	$script:PlayerTeam = $null
	$script:CurrentHasWinner = $false
	$script:CurrentGameStatus = ""
	$script:CurrentScoreKnown = $false
	$script:LastScoreTotal = -1
	$script:LastScoreMatchGuid = ""
	$script:LastPlayersSignature = ""
	$script:PlayersDetectedDue = $null
	$script:LastSelectionLogKey = ""
	Update-StatsView
}

function Try-CommitFallbackResult {
	if (-not $script:MatchGuid) {
		return
	}
	if ($script:CurrentHasWinner) {
		return
	}
	if ($script:PlayerTeam -eq $null) {
		return
	}
	if ($script:CountedMatches.ContainsKey($script:MatchGuid)) {
		return
	}
	$result = if ($script:CurrentGameStatus -eq "W") { "W" } else { "L" }
	Commit-Result $script:MatchGuid $result "guessed" (Get-ActiveMode)
}

function Open-TrackerForPlayer($playerInfo) {
	if (-not $playerInfo -or -not $playerInfo.TrackerUrl) {
		return
	}
	Start-Process $playerInfo.TrackerUrl
}

function Save-CurrentPlayerManually {
	if ($playerBox.SelectedItem) {
		Select-Player $playerBox.SelectedItem $true
		return
	}
	Save-Settings
}

function Get-SelectedGamePlayer {
	if ($playersBox.SelectedItem) {
		return $playersBox.SelectedItem
	}
	if ($playerBox.SelectedItem) {
		return $playerBox.SelectedItem
	}
	return $null
}

$form = New-Object System.Windows.Forms.Form
