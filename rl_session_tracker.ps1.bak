$form.Controls.Add($portBox)

$saveButton = New-Button "Save" 590 128 70 30
$form.Controls.Add($saveButton)

$form.Controls.Add((New-Label "Wins" 20 185 100 22))
$form.Controls.Add((New-Label "Losses" 170 185 100 22))
$form.Controls.Add((New-Label "Streak" 320 185 100 22))
$form.Controls.Add((New-Label "Last" 470 185 100 22))

$winsValue = New-Label "0" 20 210 100 48
$lossesValue = New-Label "0" 170 210 100 48
$streakValue = New-Label "0" 320 210 100 48
$lastValue = New-Label "-" 470 210 100 48
$winsValue.Font = New-Object System.Drawing.Font("Segoe UI", 26, [System.Drawing.FontStyle]::Bold)
$lossesValue.Font = New-Object System.Drawing.Font("Segoe UI", 26, [System.Drawing.FontStyle]::Bold)
$streakValue.Font = New-Object System.Drawing.Font("Segoe UI", 26, [System.Drawing.FontStyle]::Bold)
$lastValue.Font = New-Object System.Drawing.Font("Segoe UI", 26, [System.Drawing.FontStyle]::Bold)
$form.Controls.AddRange(@($winsValue, $lossesValue, $streakValue, $lastValue))

$manualWinButton = New-Button "+ Win" 20 275 90 30
$manualLossButton = New-Button "+ Loss" 120 275 90 30
$undoButton = New-Button "Undo" 220 275 90 30
$form.Controls.AddRange(@($manualWinButton, $manualLossButton, $undoButton))

$form.Controls.Add((New-Label "Team:" 20 325 80 22))
$teamValue = New-Label "-" 100 325 120 22
$form.Controls.Add($teamValue)

$form.Controls.Add((New-Label "Match:" 20 355 80 22))
$matchValue = New-Label "-" 100 355 610 22
$form.Controls.Add($matchValue)

$form.Controls.Add((New-Label "Mode:" 20 385 80 22))
$eventValue = New-Label "-" 100 385 180 22
$form.Controls.Add($eventValue)

$form.Controls.Add((New-Label "Players in current match" 20 420 220 22))
$playersBox = New-Object System.Windows.Forms.ListBox
$playersBox.Location = New-Object System.Drawing.Point(20, 445)
$playersBox.Size = New-Object System.Drawing.Size(690, 80)
$playersBox.DisplayMember = "Display"
$form.Controls.Add($playersBox)

$openTrackerButton = New-Button "Open selected RL Tracker" 20 535 180 30
$form.Controls.Add($openTrackerButton)

$logBox = New-Object System.Windows.Forms.TextBox
$logBox.Location = New-Object System.Drawing.Point(20, 575)
$logBox.Size = New-Object System.Drawing.Size(690, 85)
$logBox.Multiline = $true
$logBox.ScrollBars = "Vertical"
$logBox.BackColor = [System.Drawing.Color]::FromArgb(11, 16, 32)
$logBox.ForeColor = [System.Drawing.Color]::White
$logBox.ReadOnly = $true
$form.Controls.Add($logBox)

$timer = New-Object System.Windows.Forms.Timer
$timer.Interval = 100
$timer.Add_Tick({
	if ($script:ShouldRun) {
		Try-Connect
		Read-AvailableData
		Flush-PlayersDetectedLog $false
	}
})

$startButton.Add_Click({
	Save-Settings
	$script:ShouldRun = $true
	Set-Status "Waiting for Rocket League match..." $false
})

$stopButton.Add_Click({
	$script:ShouldRun = $false
	Close-Connection
	Set-Status "Stopped" $false
})

$resetButton.Add_Click({ Reset-Session })
$saveButton.Add_Click({ Save-CurrentPlayerManually })
$manualWinButton.Add_Click({ Add-ManualResult "W" })
$manualLossButton.Add_Click({ Add-ManualResult "L" })
$undoButton.Add_Click({ Undo-LastResult })
$openTrackerButton.Add_Click({ Open-TrackerForPlayer (Get-SelectedGamePlayer) })
$playersBox.Add_DoubleClick({ Open-TrackerForPlayer (Get-SelectedGamePlayer) })
$playerBox.Add_SelectedIndexChanged({
	if ($script:IsAutoSelecting) {
		return
	}
	if ($playerBox.SelectedItem) {
		Select-Player $playerBox.SelectedItem $true
	}
})
$form.Add_FormClosing({ Save-Settings; Close-Connection })

Initialize-StatsByMode
Load-Settings
Update-StatsView
$timer.Start()
[void]$form.ShowDialog()
