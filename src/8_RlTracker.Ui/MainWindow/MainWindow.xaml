<Window
	x:Class="GuillaumeAst.RlTracker.Ui.MainWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:views="clr-namespace:GuillaumeAst.RlTracker.Ui.Views"
	Title="RlTracker"
	SizeToContent="WidthAndHeight"
	ResizeMode="CanMinimize"
	Background="Black">
	<Grid>
	<StackPanel
		Visibility="{Binding BlockingMessageVisibility}"
		HorizontalAlignment="Center"
		VerticalAlignment="Center"
		Margin="16">
		<TextBlock
			Text="{Binding BlockingMessage}"
			Foreground="{Binding BlockingMessageColor}"
			TextAlignment="Center"
			HorizontalAlignment="Center" />

		<Button
			Content="Open config file"
			Visibility="{Binding OpenConfigButtonVisibility}"
			Click="OpenConfigButton_Click"
			Margin="0,24,0,0"
			Padding="8,4"
			HorizontalAlignment="Center" />
	</StackPanel>
	<Grid Visibility="{Binding MainTrackerVisibility}">
		<views:MainTrackerView />
	</Grid>
</Grid>
</Window>