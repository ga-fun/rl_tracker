<UserControl
	x:Class="GuillaumeAst.RlTracker.Ui.Views.MainTrackerView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<Border
		Padding="16"
		Margin="0"
		Background="Black"
		BorderBrush="#DDDDDD"
		BorderThickness="2">
		<StackPanel
			Orientation="Vertical"
			HorizontalAlignment="Center">
			<StackPanel
				Orientation="Horizontal"
				VerticalAlignment="Center">
				<StackPanel.Resources>
					<Style TargetType="TextBlock">
						<Setter Property="Foreground" Value="#DDDDDD" />
						<Setter Property="VerticalAlignment" Value="Center" />
						<Setter Property="Margin" Value="4,0" />
					</Style>
				</StackPanel.Resources>
				<TextBlock Text="{Binding WinPrefix}" />
				<TextBlock Text=" " />
				<TextBlock Text="{Binding WinCount}"/>

				<TextBlock Text=" | "/>

				<TextBlock Text="{Binding LossPrefix}" />
				<TextBlock Text=" " />
				<TextBlock Text="{Binding LossCount}"/>

				<TextBlock Text=" | "/>

				<TextBlock Text="{Binding StreakPrefix}"/>
				<TextBlock Text=" "/>
				<TextBlock Text="{Binding StreakCount}"/>

				<TextBlock Text=" | "/>

				<Button
					Content="⚙️"
					FontSize="16"
					Padding="2"
					VerticalAlignment="Center"/>
			</StackPanel>

			<TextBlock
				Text="{Binding Status}"
				Foreground="#DDDDDD"
				FontSize="14"
				Margin="0,8,0,0"
				Padding="0"
				HorizontalAlignment="Center"/>
		</StackPanel>
	</Border>
</UserControl>